# Required: create a Discord application, add a bot, and paste its token here.
DISCORD_TOKEN=replace-me

# Optional: sync commands instantly to one development server. Remove for global commands.
DISCORD_GUILD_ID=

# AMP: set this to a persistent location inside the instance data directory.
DB_PATH=./data/stockchecker.db

# Be considerate of retailer services. Values below 60 seconds are rejected.
POLL_SECONDS=180
REQUEST_TIMEOUT_SECONDS=30

# Identify the application honestly; include a contact address if desired.
HTTP_USER_AGENT=StockChecker/2.0 (+https://github.com/your-account/StockChecker)
LOG_LEVEL=INFO
